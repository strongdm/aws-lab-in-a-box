#Tags to be applied to all resources
tagset    = { environment = "Lab"
              customer    = "Partners"
              sdm-owner   = "nico.corrarello@strongdm.com"
}

#An arbitrary name to all resources
name      = "PartnerTraining"

#AWS region to deploy resources
#region    = "us-west-2"  # Change to your preferred region

#Add a linux resource with CA Authentication
create_linux_target = true

#Create a Windows Domain Controller for Certificate Authentication
#create_domain_controller = true

#Create a Windows target with Certificate Authentication
#create_windows_target = true

#Create a standalone ADCS/NDES server. Requires create_domain_controller = true,
#and derives the computer name "<name>-adcs", so keep name to 10 characters or
#fewer (Windows NetBIOS names top out at 15).
#create_adcs = true

#Which StrongDM node carries the ADCS/NDES enrollment credentials: "relay"
#(default) or "gateway". Leave at "relay" in this lab's default topology -
#the DC, Windows target and ADCS server sit in private subnets only the
#relay can reach.
#adcs_credentials_node = "relay"

#Create a PostgreSQL Database with its secret stored in AWS Secrets Manager
#create_rds_postgresql = true

#Create an EKS Cluster Target
#create_eks = true

#Create an DocumentDB Replicaset Cluster Target
#create_docdb = true

#Onboard domain users to be managed by StrongDM
#create_managedsecrets = true

#Create worked examples of roles, Cedar policies and approval workflows for this lab
#create_lab_access = true

#Accounts that may approve the lab's sensitive access requests
#lab_approver_account_ids = ["a-xxxxxxxxxxxxxxxx"]


#Allow to access secrets with this key/value
secretkey = "sdm-owner"
secretvalue = "nico.corrarello@strongdm.com"

domain_users = [ 
    {
      "SamAccountName" = "jdoe"
      "GivenName"      = "Jane"
      "Surname"        = "Doe"
      "tags"           = {mfa = "true"}
    },
    {
      "SamAccountName" = "nchandler"
      "GivenName"      = "Noah"
      "Surname"        = "Chandler"
      "tags"           = {justify = "true"}
    },
    {
      "SamAccountName" = "eyang"
      "GivenName"      = "Eva"
      "Surname"        = "Yang"
      "tags"           = {owner = "eva.yang@strongdm.com"}
    }
]